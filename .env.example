# ── RyzenDesk configuration ─────────────────────────────────────────
# Copy to .env and adjust before production deployment.

# SESSION_SECRET (REQUIRED IN PRODUCTION)
# HMAC secret for session cookies, at-rest secret encryption and the
# AES-256-GCM cloud-sync envelope. Generate with: openssl rand -hex 32
# Production refuses to push cloud-sync snapshots while this is unset/default.
SESSION_SECRET="change-me-to-a-long-random-string"

# ENCRYPTION_KEY (optional — falls back to SESSION_SECRET)
# Dedicated key for AES-256-GCM database snapshot encryption.
# ENCRYPTION_KEY=""

# Server
PORT="3000"

# Bootstrap Super Admin (password rotation is enforced on first login)
SUPERADMIN_USERNAME="admin"
SUPERADMIN_PASSWORD="RyzenAdmin@2026"

# Gemini AI Copilot (optional — heuristic fallback active without it)
GEMINI_API_KEY=""

# GitHub Database Cloud Sync (snapshots are AES-256-GCM encrypted before push)
GITHUB_TOKEN=""
GITHUB_REPO="romangalaxys10-spec/RyzenDesk"
GITHUB_BRANCH="main"
GITHUB_DB_PATH="data/helpdesk-db.json"

# Telegram Bot Notifications
TELEGRAM_BOT_TOKEN=""

# SMTP Email Notifications (credentials are encrypted at rest)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="support@ryzendesk.internal"
SMTP_SECURE="false"
